  const width=items[i].width+(items[j].width-items[i].width)*t;
  return {left:c-width/2,width};
 }
+
+// Candidate boundary resistance, isolated behind the workbench opt-in.
+export function segmentResistance(center:number,first:number,last:number){
+ const edge=center<first?first:center>last?last:center;
+ const excess=center-edge;
+ return edge+excess*.45/(1+Math.abs(excess)/48);
+}
