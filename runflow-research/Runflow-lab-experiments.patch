+export default function InteractionMetrics({variant}:{variant:string}){
+ const [running,setRunning]=useState(false),[reports,setReports]=useState<string[]>([]);const revision=useRef(variant);revision.current=variant;
+ useEffect(()=>{if(!running)return;const label=revision.current;let raf=0,last=0,frames:number[]=[],slow=0,forced=0;
