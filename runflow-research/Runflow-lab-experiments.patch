+'use client';
+import {useEffect,useRef} from 'react';
+import {useFrameSpring} from './useFrameSpring';
+import {menuMorph,type MenuRect} from '../lib/menu-morph';
+export function useMenuLayer(){
+ const progress=useFrameSpring(0,{stiffness:390,damping:40});
+ const job=useRef<{el:HTMLElement;source:MenuRect;target:MenuRect;open:boolean;done:()=>void}|null>(null);
+ const draw=()=>{const j=job.current;if(!j)return;const start=performance.now(),p=progress.get(),f=menuMorph(p,j.source,j.target),shell=j.el.querySelector<HTMLElement>('.glass-menu-shell'),content=j.el.querySelector<HTMLElement>('.glass-menu-options');
+  if(shell){shell.style.transform=`translate(${f.x}px,${f.y}px) scale(${f.sx},${f.sy})`;shell.style.opacity=String(.78+.22*Math.max(0,Math.min(1,p)));shell.style.boxShadow=`inset 0 1px 1px #ffffff55,0 ${4+p*12}px ${12+p*24}px #00000035`;}
+  if(content){content.style.transform='none';content.style.opacity=String(f.opacity);content.style.clipPath=`inset(${f.clipTop}px ${f.clipRight}px ${f.clipBottom}px ${f.clipLeft}px round 14px)`;}
+  j.el.dataset.menuProgress=p.toFixed(3);j.el.dataset.menuWriteMs=(performance.now()-start).toFixed(3);
+  if(!j.open&&p===0){job.current=null;j.done()}
+ };
+ useEffect(()=>progress.on('change',draw),[progress]);
+ return {start(el:HTMLElement,source:MenuRect,target:MenuRect,open:boolean,done:()=>void){const fresh=job.current?.el!==el;job.current={el,source,target,open,done};el.style.transform='none';el.style.opacity='1';el.style.overflow='visible';if(fresh)progress.jump(0);if(matchMedia('(prefers-reduced-motion: reduce)').matches)progress.jump(open?1:0);else progress.set(open?1:0);draw()},stop(){job.current=null;progress.jump(0)}};
+}
