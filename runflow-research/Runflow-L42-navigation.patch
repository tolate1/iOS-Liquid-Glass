@@ -0,0 +1,15 @@
+/* Keep the specimen in normal flow. No portal, viewport-dependent mounting or
+   fixed positioning underneath mobile browser chrome. Production Dock is unchanged. */
+.interaction-lab .lab-navigation-specimen{position:relative;margin:18px 0 24px;width:100%;min-width:0}
+.interaction-lab .lab-navigation-specimen nav.glass-navigation{
+ position:relative!important;inset:auto!important;transform:none!important;
+ display:grid!important;width:100%!important;max-width:100%;z-index:1;
+ visibility:visible;opacity:1;
+}
+@media(max-width:850px){
+ .interaction-lab .lab-navigation-specimen nav.glass-navigation{
+  grid-template-columns:repeat(5,minmax(0,1fr));gap:0;padding:4px;
+ }
+ .interaction-lab .lab-navigation-specimen nav.glass-navigation button{min-width:0;min-height:60px;padding:6px 0}
+ .interaction-lab .lab-navigation-specimen nav.glass-navigation button>.nav-visual{padding:6px 0;font-size:9px}
+}
