+.app .summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;padding:14px 0;margin:8px 0;border:0;border-bottom:1px solid var(--line);border-radius:0;background:none;box-shadow:none;font-variant-numeric:tabular-nums}
+.summary b{font-size:15px;font-weight:600}.summary small{display:block;font-size:10px;color:var(--muted);margin-bottom:5px;font-weight:400}
+.app .modal .fine{font-size:11px;line-height:1.6}.app .modal textarea{width:100%;min-height:70px;margin-bottom:12px}
+.app .modalfoot{flex:none;position:relative;display:flex;justify-content:flex-end;gap:8px;padding:12px 22px;margin:0;background:var(--surface);border-top:1px solid var(--line);box-shadow:0 -4px 12px #00000003;-webkit-backdrop-filter:none;backdrop-filter:none}
+.app .modalfoot button{min-height:44px;font-size:12px}.app .modalfoot .primary{min-width:190px;background:var(--accent);color:var(--accentink)}
+.app .modalfoot .danger{margin-right:auto}
+.app .overlay.is-closing .modal{animation:sheet-close .24s ease both}
+@keyframes sheet-open{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
+@keyframes sheet-close{to{opacity:0;transform:translateY(12px)}}
+@media(min-width:601px){
+ .lapscroll tbody:has(>tr:only-child)>tr{grid-template-columns:repeat(4,minmax(0,1fr))}
+ .lapscroll tbody:has(>tr:only-child) td:nth-child(3){grid-column:1/4;grid-row:2}
+ .lapscroll tbody:has(>tr:only-child) td:nth-child(2){grid-column:4;grid-row:2}
+ .lapscroll tbody:has(>tr:only-child) td:nth-child(4){grid-column:1/3}
+ .lapscroll tbody:has(>tr:only-child) td:nth-child(5){grid-column:3/5}
+}
+@media(max-width:600px){
+ .app .overlay{padding:12px 0 0;align-items:flex-end}.app .modal{width:100%;max-height:calc(100dvh - 12px);border-radius:24px 24px 0 0}
+ .app .modal>.panelhead{padding:12px 16px}.app .modal h2{font-size:20px}.modal-body{padding:12px 16px}
+ .formrow{grid-template-columns:1fr}.lapscroll tbody{grid-template-columns:1fr}
+ .app .modalfoot{padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px))}.app .modalfoot .primary{flex:1;min-width:0}
+ .app .summary{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.app .modalfoot .danger{padding:8px;font-size:11px}
+}
+@media(prefers-reduced-motion:reduce){.app .modal,.app .overlay.is-closing .modal{animation:none}}
+@media(prefers-reduced-transparency:reduce),(prefers-contrast:more){.app .overlay{-webkit-backdrop-filter:none;backdrop-filter:none}}
