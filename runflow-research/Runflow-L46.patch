+import {readFileSync,readdirSync} from 'node:fs';
+import assert from 'node:assert/strict';
+const folder='dist/client/_next/static/css';
+const css=readdirSync(folder).filter(f=>f.endsWith('.css')).map(f=>readFileSync(folder+'/'+f,'utf8')).join('\n');
+const rules=[...css.matchAll(/([^{}]+)\{([^{}]*)\}/g)];
+const hasStandard=(selector,value)=>rules.some(([,s,body])=>s.includes(selector)&&new RegExp('(?:^|;)backdrop-filter:'+value+'(?:;|$)').test(body));
+assert.ok(hasStandard('.glass-lens-surface[data-rf-glass=svg]','var\\(--rf-backdrop\\)'), 'Built SVG lens lost its standard backdrop-filter');
+assert.ok(hasStandard('[data-dock-axis=horizontal] .dock-material','blur\\(4px\\)'), 'Built substrate lost its standard backdrop-filter');
+assert.ok(hasStandard('[data-dock-axis=horizontal] .glass-lens-surface','blur\\(\\.6px\\)'), 'Built fallback lens lost its standard backdrop-filter');
+console.log('Production CSS retains standard SVG, substrate and fallback backdrop filters.');
