+   <div role="group" aria-label="Положение">{tabs.map(([v,l])=><button key={v} aria-pressed={tab===v} onClick={()=>setTab(v)}>{l}</button>)}</div>
+   <div role="group" aria-label="Фон">{[['lines','Линии'],['text','Текст'],['card','Карточка'],['black','Чёрный'],['white','Белый']].map(([v,l])=><button key={v} aria-pressed={backdrop===v} onClick={()=>setBackdrop(v)}>{l}</button>)}</div>
+  </div>
+  <div className="dock-review-pair">{(variant==='both'?['l45','l46']:[variant]).map(v=><section key={v}>
+   <h2>{v==='l45'?'A · L45':'B · L46'}</h2>
+   <div className={'dock-review-scene backdrop-'+backdrop}>
+    <div className="dock-review-content" aria-hidden="true">{backdrop==='text'?Array.from({length:9},(_,i)=><p key={i}>Runflow 0123456789 · Темп · круги · 0123456789<br/>Дистанция · стабильность · Runflow 0123456789</p>):backdrop==='lines'?<svg viewBox="0 0 370 260" preserveAspectRatio="none"><path d="M0 200 L60 140 L120 180 L180 80 L240 130 L300 50 L370 100 M0 50 L370 250 M0 250 L370 50" fill="none" stroke="currentColor" strokeWidth="2"/>{[20,60,100,140,180,220].map(y=><path key={y} d={`M0 ${y}H370`} stroke="currentColor" strokeWidth=".5"/>)}</svg>:backdrop==='card'?<article><b>Вечерний стадион</b><p>2,40 км · 13:39</p><strong>10,55 км/ч</strong></article>:null}</div>
+    {v==='l45'?<LegacyGlassNavigation active={tab} count={7} onChange={change}/>:<GlassNavigation active={tab} count={7} onChange={change}/>}
+   </div>
+  </section>)}</div>
+  <p role="status">Раздел: {tab}. Принято переключений: {commits}.</p>
+  <p>Удерживай, веди к краю, меняй направление и отпускай. Во время перетаскивания раздел не меняется. Оба образца используют рабочие компоненты; данные тренировок не затрагиваются.</p>
+  <p>SVG displacement проверяется отдельно от размытия. При неподдерживаемом фильтре используется прозрачный материал с blur; это не нативный рендерер Apple.</p>
+ </main></div>;
+}
