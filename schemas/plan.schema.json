{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Liquid Glass migration review plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designMode", "routes", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "designMode": { "enum": ["preserve-brand", "ios-transform"] },
    "routes": { "type": "array", "items": { "type": "string" } },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "sourceHash", "role", "action", "risk", "checks"],
        "properties": {
          "source": { "$ref": "https://ios-liquid-glass.local/inventory-v1#/definitions/source" },
          "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "role": { "type": "string" },
          "action": { "enum": ["wrap-and-restyle", "retokenize", "preserve", "manual-review"] },
          "risk": { "enum": ["low", "medium", "high"] },
          "checks": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  }
}
