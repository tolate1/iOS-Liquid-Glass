{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Liquid Glass project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "framework", "designMode", "preset", "renderer", "fallback", "scope", "exclude"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "framework": { "enum": ["react", "next", "vanilla", "unsupported"] },
    "designMode": { "enum": ["preserve-brand", "ios-transform"] },
    "preset": { "enum": ["ios-neutral-light", "ios-neutral-dark"] },
    "renderer": { "enum": ["auto", "svg-backdrop", "frosted-css", "opaque"] },
    "fallback": { "enum": ["frosted-css", "opaque"] },
    "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "exclude": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/path" } }
  },
  "definitions": {
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[a-zA-Z0-9_./ ()@-]+$" }
  }
}
