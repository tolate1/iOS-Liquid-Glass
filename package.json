{
  "name": "@ios-liquid-glass/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node skills/ios-liquid-glass/scripts/test-displacement-map.mjs && node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:browser": "npm run build && node scripts/build-react-fixture.mjs && node --test tests/*.browser.mjs",
    "typecheck": "tsc --noEmit --strict --lib es2022,dom --module nodenext tests/types.mts",
    "demo": "npm run build && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "parse5": "^8.1.1",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "bin": {
    "ios-liquid-glass": "./dist/cli.cjs"
  }
}
